---
import covers from '../data/covers.json';

interface Props {
  titulo: string;
  autor: string;
  estado: 'leyendo' | 'leido' | 'quiero-leer';
  origen?: 'propio' | 'biblioteca';
  anio?: number;
  isbn?: string | null;
  nota?: number | null;
}

const { titulo, autor, estado, origen, isbn = null, nota = null } = Astro.props;

const coverUrl = isbn
  ? `https://covers.openlibrary.org/b/isbn/${isbn}-M.jpg`
  : ((covers as Record<string, string | null>)[`${titulo}|${autor}`] ?? null);

const estadoLabel: Record<string, string> = {
  leyendo: 'Leyendo',
  'quiero-leer': 'Quiero leer',
};
---

<div class="book" data-estado={estado} data-origen={origen}>
  <div class="cover">
    {coverUrl ? (
      <img src={coverUrl} alt={`Portada de ${titulo}`} loading="lazy" />
    ) : (
      <div class="fallback">{titulo}</div>
    )}
  </div>
  <div class="info">
    <div class="title">{titulo}</div>
    <div class="author">{autor}</div>
    {nota && <div class="stars">{'★'.repeat(nota)}{'☆'.repeat(5 - nota)}</div>}
    {estadoLabel[estado] && <span class={`badge ${estado}`}>{estadoLabel[estado]}</span>}
    {origen === 'biblioteca' && <span class="badge biblioteca">Biblioteca</span>}
  </div>
</div>
