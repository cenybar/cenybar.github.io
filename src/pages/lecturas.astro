---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from '../components/BookCard.astro';
import books from '../data/books.json';

const years = [...new Set(books.map((b) => b.anio))].sort((a, b) => b - a);
---

<BaseLayout title="Lecturas — Santiago" wide>
  <h1>Lecturas</h1>
  <p style="color: var(--text-muted);">
    Registro de mis lecturas, entre libros propios y préstamos de la biblioteca.
  </p>

  <div class="filters">
    <button class="active" data-filter="todos">Todos</button>
    <button data-filter="propio">Míos</button>
    <button data-filter="biblioteca">Biblioteca</button>
  </div>

  {years.map((year) => (
    <section>
      <h2>{year}</h2>
      <div class="book-grid">
        {books
          .filter((b) => b.anio === year)
          .map((b) => (
            <BookCard {...(b as any)} />
          ))}
      </div>
    </section>
  ))}
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const books = document.querySelectorAll<HTMLElement>('.book');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.dataset.filter;
      books.forEach((book) => {
        book.style.display =
          filter === 'todos' || book.dataset.origen === filter ? '' : 'none';
      });
    });
  });
</script>
